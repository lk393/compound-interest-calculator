<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>资本利得税计算器 - Smart Finance Tools</title>
    <link rel="stylesheet" href="style.css" />
</head>
<body>
    <div class="container" style="max-width: 700px; margin: 40px auto; padding: 20px;">
        <h1>📉 资本利得税计算器</h1>
        <p>计算股票/资产出售后的短期或长期资本利得税。</p>
        <div class="card" style="padding: 25px; background: #f9fafc; border-radius: 16px;">
            <div class="input-group" style="margin-bottom: 15px;">
                <label>买入价格 (¥)</label>
                <input type="number" id="buyPrice" value="10000" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:8px;">
            </div>
            <div class="input-group" style="margin-bottom: 15px;">
                <label>卖出价格 (¥)</label>
                <input type="number" id="sellPrice" value="15000" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:8px;">
            </div>
            <div class="input-group" style="margin-bottom: 15px;">
                <label>持有期限 (年) - 小于1年为短期</label>
                <input type="number" id="holdingYears" value="2" step="0.1" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:8px;">
            </div>
            <div class="input-group" style="margin-bottom: 20px;">
                <label>年收入 (用于确定长期税率) (¥)</label>
                <input type="number" id="income" value="50000" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:8px;">
            </div>
            <button onclick="calcCapGains()" class="btn" style="background:#2563eb; color:#fff; padding:12px 24px; border:none; border-radius:8px; cursor:pointer; font-size:16px;">计算</button>
            <div id="result" style="margin-top: 20px; font-size: 16px; background: #eef2ff; padding: 15px; border-radius: 8px;"></div>
        </div>
    </div>
    <script>
        function calcCapGains() {
            const buy = parseFloat(document.getElementById('buyPrice').value);
            const sell = parseFloat(document.getElementById('sellPrice').value);
            const years = parseFloat(document.getElementById('holdingYears').value);
            const income = parseFloat(document.getElementById('income').value);
            if (isNaN(buy) || isNaN(sell) || isNaN(years) || isNaN(income)) return alert('请输入有效数字');
            const gain = sell - buy;
            let tax = 0;
            let rate = 0;
            if (years < 1) {
                // 短期：按普通所得税率（简化取22%）
                rate = 0.22;
                tax = gain * rate;
            } else {
                // 长期：0%, 15%, 20% 基于收入
                if (income <= 47025) rate = 0;
                else if (income <= 518900) rate = 0.15;
                else rate = 0.20;
                tax = gain * rate;
            }
            document.getElementById('result').innerHTML = `
                <strong>📈 资本利得</strong>：¥${gain.toFixed(2)}<br>
                <strong>🧾 适用税率</strong>：${(rate * 100).toFixed(1)}% (${years >= 1 ? '长期' : '短期'})<br>
                <strong>💰 应缴税款</strong>：¥${tax.toFixed(2)}
            `;
        }
    </script>
    <script src="feedback.js"></script>
    <script src="recommendations.js"></script>
</body>
</html>
